# dependencies
node_modules/
/.pnp
.pnp.*

# keep only the project README among Markdown documents
*.[mM][dD]
!/README.md

# npm is the canonical package manager; package-lock.json stays tracked
/pnpm-lock.yaml
/yarn.lock
/bun.lock
/bun.lockb

# generated test output
/coverage/
/test-results/
/vitest-report/
/.vitest/

# application builds and local caches
/.next/
/out/
/build/
/dist/
/.cache/
.vite/
*.tsbuildinfo
next-env.d.ts

# local environment and credentials
.env*
!.env.example
!.env.*.example
*.pem
/.aws/
.codex
.mcp.json
/.impeccable/config.local.json

# local deployment state and SQL snapshots
/.vercel/
/supabase/.temp/
/supabase/migrations/
.git_old

# operating system and package-manager logs
.DS_Store
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
